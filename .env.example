# =============================================================================
# KPA Welfare Management System — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
APP_NAME="KPA Welfare Management System"
APP_VERSION=1.0.0
DEBUG=true                               # false in production

# ─── Backend API ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,exp://localhost:8081

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-use-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kpa_user:kpa_password@localhost:5432/kpa_db
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://kpa_user:kpa_password@localhost:5432/kpa_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── OTP / Authentication ────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=10
# Set to true in development to skip real SMS and use a fixed OTP
OTP_DEV_MODE=true
OTP_DEV_FIXED_CODE=123456

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_BUCKET_MEMBERS=kpa-members
SUPABASE_BUCKET_WELFARE=kpa-welfare

# ─── Razorpay (Primary Payment Gateway) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Razorpay UPI AutoPay / eMandate
RAZORPAY_AUTOPAY_MAX_AMOUNT=1000          # max per-debit in paise

# ─── Cashfree (Alternative Payment Gateway) ──────────────────────────────────
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
CASHFREE_ENVIRONMENT=TEST                # TEST | PRODUCTION

# ─── Firebase Cloud Messaging ────────────────────────────────────────────────
# Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR provide the JSON content as a string (for container environments)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── SMS — MSG91 ─────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=KPAWEL
MSG91_TEMPLATE_OTP=your-otp-template-id
MSG91_TEMPLATE_WELFARE=your-welfare-template-id

# ─── SMS — Twilio (Alternative) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Active SMS provider: msg91 | twilio
SMS_PROVIDER=msg91

# ─── Email ───────────────────────────────────────────────────────────────────
# Provider: sendgrid | resend | ses | smtp
EMAIL_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=noreply@kpawelfare.org
EMAIL_FROM_NAME="KPA Welfare"

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Resend
RESEND_API_KEY=your-resend-api-key

# SMTP (generic)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_TLS=true

# ─── File Upload Restrictions ────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Celery / Background Tasks ───────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=4
BULK_IMPORT_CHUNK_SIZE=500

# ─── Web Admin Frontend ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="KPA Admin"

# ─── Mobile App ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_APP_NAME="KPA Welfare"
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                          # json | text

# ─── Monitoring (Production) ─────────────────────────────────────────────────
SENTRY_DSN=
