# =============================================================================
# KPA Welfare Management System — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="KPA Welfare Management System"
APP_VERSION=1.0.0
DEBUG=true

# ─── Backend API ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","exp://localhost:8081"]
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# ─── Security ────────────────────────────────────────────────────────────────
# Minimum 32 characters in production
SECRET_KEY=kpa-dev-only-secret-key-replace-this-in-production-with-64char-random

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (local dev): sqlite+aiosqlite:///./kpa_dev.db / sqlite:///./kpa_dev.db
# PostgreSQL (production): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./kpa_dev.db
DATABASE_SYNC_URL=sqlite:///./kpa_dev.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── OTP (Legacy / Admin) ────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=10
OTP_RATE_LIMIT_PER_HOUR=50
OTP_DEV_MODE=true
OTP_DEV_FIXED_CODE=123456

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Matches VITE_GOOGLE_CLIENT_ID in apps/web/.env
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz1234567890.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_ONLY=true

# ─── External Services (Optional for Local Dev) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_AUTOPAY_MAX_AMOUNT=1000

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=TEST

FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=KPAWEL
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_WELFARE=

SENDGRID_API_KEY=
RESEND_API_KEY=

EMAIL_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=noreply@kpawelfare.org
EMAIL_FROM_NAME="KPA Welfare"

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
