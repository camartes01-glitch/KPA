# KPA Web Frontend — Environment Configuration Template
VITE_API_URL=http://localhost:8000/api/v1
# Google OAuth 2.0 Web Client ID from Google Cloud Console (APIs & Services > Credentials)
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz1234567890.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
